# Environment configuration (Contains sensitive API keys & secrets)
.env
**/.env
.env.*
!.env.example

# Python bytecode & cache
__pycache__/
**__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Temporary snapshot captures
product recognition/snapshots/*.jpg
product recognition/snapshots/*.png
**/snapshots/*.jpg
**/snapshots/*.png
!**/snapshots/.gitkeep

# Archives and temporary files
*.zip
*.tar.gz
*.log
*.tmp
*.bak

# Virtual environments
venv/
.venv/
env/
ENV/

# OS & Editor generated files
.DS_Store
Thumbs.db
.vscode/
.idea/
